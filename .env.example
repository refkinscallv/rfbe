# APPLICATION
APP_ENV=development
APP_NAME=RFBE
APP_URL=http://localhost:3000
APP_PORT=3000
APP_TIMEZONE=Asia/Jakarta
# 32+ byte secret used to derive the AES key for Common.Crypt. Run `npm run setup` to generate.
APP_KEY=

# DATABASE (mysql2 + sequelize)
# Set DB_ENABLED=false to run without a database (skips connect/sync on boot)
DB_ENABLED=true
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=rfbe
DB_TIMEZONE=+07:00
DB_LOGGING=false
# Schema sync on boot (development convenience; keep all false in production)
DB_SYNC=false
DB_FORCE=false
DB_ALTER=false
# When true, `npm run db:migrate` scaffolds a model for any table missing one
DB_AUTO_MODEL=false
# Connection pool
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT (jsonwebtoken)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# BCRYPT
BCRYPT_SALT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# EXPRESS
EXPRESS_TRUST_PROXY=false
EXPRESS_BODY_LIMIT=10mb

# RATE LIMIT (express-rate-limit)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# MULTER (file upload)
UPLOAD_PATH=storage/uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# AXIOS
AXIOS_BASE_URL=
AXIOS_TIMEOUT=10000

# LOGGING (winston + winston-daily-rotate-file)
LOG_LEVEL=debug
LOG_FILE=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# RUNTIME
RUNTIME_MAX_LISTENERS=50
RUNTIME_STACK_TRACE_LIMIT=50
RUNTIME_UV_THREADPOOL_SIZE=4
RUNTIME_BIGINT_JSON=true
RUNTIME_DEPRECATION_WARNINGS=true

# STORAGE (filesystem root for Common.Storage)
STORAGE_ROOT=storage

# CACHE (in-memory default TTL, seconds)
CACHE_TTL=3600

# CRON (node-cron)
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Jakarta
# Set CRON_HISTORY=false to disable execution history recording in the database
CRON_HISTORY=true

# QUEUE (in-process job queue)
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=1000
# Set QUEUE_PERSIST=false to disable database persistence (jobs lost on restart)
QUEUE_PERSIST=true

# SOCKET (socket.io)
SOCKET_ENABLED=true
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=*
SOCKET_PING_TIMEOUT=20000

# MAIL (nodemailer)
# Set MAIL_ENABLED=false to no-op sends in local/dev without an SMTP server
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=RFBE
