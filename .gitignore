# Dependencies
node_modules/

# Environment — never commit real secrets; .env.example is the template
.env
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# Runtime upload/storage artifacts (keep the folders, ignore the contents)
storage/uploads/*
!storage/uploads/.gitkeep

# Generated / OS / editor noise
coverage/
.nyc_output/
.DS_Store
Thumbs.db
.idea/
*.tsbuildinfo

# Keep VS Code shared settings out unless intentionally committed
.vscode/*
!.vscode/extensions.json

# Local agent / tooling state
.claude/
